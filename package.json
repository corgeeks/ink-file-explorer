{
  "name": "@corgeeks/ink-file-explorer",
  "version": "0.1.0",
  "description": "A vim-inspired file explorer component for Ink CLI applications",
  "keywords": ["ink", "cli", "file-explorer", "terminal", "react", "vim"],
  "repository": {
    "type": "git",
    "url": "https://github.com/corgeek/ink-file-explorer.git"
  },
  "bugs": {
    "url": "https://github.com/corgeek/ink-file-explorer/issues"
  },
  "homepage": "https://github.com/corgeek/ink-file-explorer#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "ink-file-explorer": "./dist/main.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@types/bun": "latest",
    "@types/node": "^20.0.0",
    "@types/prop-types": "^15.7.15",
    "@types/react": "^19.0.0",
    "ink": "^6.3.1",
    "ink-testing-library": "^4.0.0",
    "oxlint": "^1.22.0",
    "oxlint-tsgolint": "^0.2.0",
    "react": "^19.2.0",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "typescript": "^5",
    "ink": "^6.0.0",
    "react": "^19.0.0"
  },
  "dependencies": {
    "prop-types": "^15.8.1"
  },
  "scripts": {
    "dev": "bun run src/main.tsx",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "test:watch": "bun test --watch",
    "build": "bun run build.ts",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  }
}
