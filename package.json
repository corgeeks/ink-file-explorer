{
  "name": "@corgeeks/ink-file-explorer",
  "version": "0.1.0",
  "description": "A vim-inspired file explorer component for Ink CLI applications",
  "keywords": [
    "ink",
    "cli",
    "file-explorer",
    "terminal",
    "react",
    "vim"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/corgeek/ink-file-explorer.git"
  },
  "bugs": {
    "url": "https://github.com/corgeek/ink-file-explorer/issues"
  },
  "homepage": "https://github.com/corgeek/ink-file-explorer#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "ink-file-explorer": "./dist/main.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@eslint/js": "^9.39.1",
    "@types/bun": "latest",
    "@types/node": "^24.10.1",
    "@types/prop-types": "^15.7.15",
    "@types/react": "^19.2.6",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "husky": "^9.1.7",
    "ink": "^6.5.1",
    "ink-testing-library": "^4.0.0",
    "react": "^19.2.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.47.0"
  },
  "peerDependencies": {
    "typescript": "^5",
    "ink": "^6.0.0",
    "react": "^19.0.0"
  },
  "dependencies": {
    "prop-types": "^15.8.1"
  },
  "scripts": {
    "dev": "bun run src/main.tsx",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "test:watch": "bun test --watch",
    "build": "bun run build.ts",
    "clean": "rm -rf dist",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "bun run build",
    "prepare": "husky"
  }
}
